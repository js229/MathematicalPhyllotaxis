Cell[BoxData[{
 RowBox[{
  RowBox[{"countbins", " ", "=", " ", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Below\>\"", ",", "\"\<Average\>\"", ",", "\"\<Above\>\""}],
       "}"}], ",", 
     RowBox[{"Partition", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "8", ",", "12", ",", "100"}], "}"}], ",", "2", ",", 
       "1"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"countToBin", " ", "[", "count_", "]"}], " ", ":=", " ", 
   RowBox[{"First", "@", 
    RowBox[{"Keys", "@", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"Map", "[", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"IntervalMemberQ", "[", 
           RowBox[{
            RowBox[{"Interval", "[", "#", "]"}], ",", "count"}], "]"}], "&"}],
          ",", "countbins"}], "]"}], ",", "TrueQ"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"colourBin", " ", "=", " ", 
    RowBox[{"AssociationThread", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Below\>\"", ",", "\"\<Average\>\"", 
        ",", "\"\<Above\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"jParastichyColour", "[", "4", "]"}], ",", 
        RowBox[{"jStyle", "[", "\"\<CylinderColour\>\"", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"jParastichyColour", "[", "1", "]"}]}], "}"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"colourFunction", "[", "count_", "]"}], " ", ":=", 
   RowBox[{"colourBin", "[", 
    RowBox[{"countToBin", "[", "count", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9463676480713806`*^9, 3.9463676497105064`*^9}},
