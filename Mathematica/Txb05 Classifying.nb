Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"angleDistributionPlot", "[", "angle_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"angleBins", " ", "=", " ", 
         RowBox[{"Subdivide", "[", 
          RowBox[{"0", ",", 
           RowBox[{"2", "\[Pi]"}], ",", "100"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"angleHalfWidth", " ", "=", " ", 
         RowBox[{"\[Pi]", "/", "100"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"cmax", " ", "=", " ", "20"}], ";", "\[IndentingNewLine]", 
        RowBox[{"bincounts", " ", "=", " ", 
         RowBox[{"BinCounts", "[", 
          RowBox[{
           RowBox[{"angleDistribution", "[", "angle", "]"}], ",", 
           RowBox[{"{", "angleBins", "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"angleCount", "  ", "=", " ", 
         RowBox[{"Transpose", "[", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Drop", "[", 
             RowBox[{"angleBins", "  ", ",", 
              RowBox[{"-", "1"}]}], "]"}], ",", "bincounts"}], "}"}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"colourFunction", "[", "count_", "]"}], " ", ":=", 
         RowBox[{"colourBin", "[", 
          RowBox[{"countToBin", "[", "count", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"colourFunction", "[", 
               RowBox[{
               "#", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
               "]"}], ",", " ", 
              RowBox[{"Annulus", "[", " ", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"0", ",", "0"}], "}"}], ",", "1", ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "-", "angleHalfWidth"}], ",", 
                  RowBox[{
                   RowBox[{
                   "#", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "+", "angleHalfWidth"}]}], 
                 "}"}]}], "]"}]}], "}"}], "&"}], ",", "angleCount"}], "]"}], 
         "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"makeCh4SpiralPacking", " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"nPoints", " ", "=", " ", "1000"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rise", " ", "=", " ", 
         RowBox[{"1", "/", "nPoints"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"spiral", "[", "angle_", "]"}], " ", ":=", " ", 
         RowBox[{"Table", "[", " ", 
          RowBox[{
           RowBox[{"n", " ", "rise", " ", "*", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Cos", "[", " ", 
               RowBox[{"n", " ", "angle"}], "]"}], ",", 
              RowBox[{"Sin", "[", 
               RowBox[{"n", " ", "angle"}], "]"}]}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "nPoints"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"angleDistribution", "[", "angle_", "]"}], " ", ":=", "  ", 
         RowBox[{"Table", "[", " ", 
          RowBox[{
           RowBox[{"Mod", "[", " ", 
            RowBox[{
             RowBox[{"n", " ", "angle"}], ",", 
             RowBox[{"2", "\[Pi]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "nPoints"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"angles", " ", "=", "   ", 
         RowBox[{"GoldenAngle", " ", "*", 
          RowBox[{"{", " ", 
           RowBox[{
            RowBox[{"1", "/", "1.001"}], ",", "1", ",", "1.001"}], "}"}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"alabels", " ", "=", 
         RowBox[{"alabels", " ", "=", 
          RowBox[{"Map", "[", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Graphics", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"EdgeForm", "[", "None", "]"}], ",", 
                RowBox[{"FaceForm", "[", "None", "]"}], ",", 
                RowBox[{"Rectangle", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"-", "1"}], "/", "2"}], ",", 
                    RowBox[{"-", ".1"}]}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"1", "/", "2"}], ",", "0.1"}], "}"}]}], "]"}], ",", 
                RowBox[{"Text", "[", 
                 RowBox[{
                  RowBox[{"Style", "[", 
                   RowBox[{"#", ",", "setGill"}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", "0"}], "}"}]}], "]"}]}], "}"}], "]"}], 
             "&"}], ",", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<\!\(\*SuperscriptBox[\(\[Tau]\), \
\(-2\)]\)/1.001\>\"", 
              ",", "\"\<\!\(\*SuperscriptBox[\(\[Tau]\), \(-2\)]\)\>\"", 
              ",", "\"\<1.001 \!\(\*SuperscriptBox[\(\[Tau]\), \
\(-2\)]\)\>\""}], "}"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"boxes", " ", "=", " ", 
         RowBox[{"GraphicsColumn", "/@", " ", 
          RowBox[{"(", 
           RowBox[{"Transpose", "@", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{"alabels", ",", "\[IndentingNewLine]", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Graphics", "[", 
                  RowBox[{"Point", "[", 
                   RowBox[{"spiral", "[", "#", "]"}], "]"}], "]"}], "&"}], ",",
                 "angles"}], "]"}], ",", "\[IndentingNewLine]", 
              RowBox[{"Map", "[", 
               RowBox[{"angleDistributionPlot", ",", "angles"}], "]"}]}], 
             "\[IndentingNewLine]", "}"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"g", "=", " ", 
         RowBox[{"GraphicsRow", "[", 
          RowBox[{"Append", "[", 
           RowBox[{"boxes", ",", 
            RowBox[{"Graphics", "[", "]"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"legbox", " ", ":=", " ", 
         RowBox[{"SwatchLegend", "[", " ", 
          RowBox[{
           RowBox[{"Values", "[", "colourBin", "]"}], ",", 
           RowBox[{"Keys", "[", "colourBin", "]"}], ",", 
           RowBox[{"LabelStyle", "->", "setGill"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
           "LegendLabel", "\[Rule]", "\"\<Angular node density\>\""}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Legended", "[", 
         RowBox[{"g", ",", 
          RowBox[{"Placed", "[", 
           RowBox[{"legbox", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{".95", ",", "0.2"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], "]"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
   "Txb0508SpiralPacking", ":=", " ", "makeCh4SpiralPacking"}]}]}]], "Input",
