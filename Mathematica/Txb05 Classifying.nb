Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"opposedTreePlot", "[", 
     RowBox[{"mnPairs_", ",", "labelPairs_", ",", "highLightPairs_", ",", 
      RowBox[{"opts", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"regionLabel", ",", "prunedTree"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"regionLabel", "[", "mn_", "]"}], " ", ":=", " ", 
        RowBox[{"panelLabel", "[", 
         RowBox[{"mn", ",", 
          RowBox[{"vanItersonLabelPoint", "[", "mn", "]"}], ",", "0.15"}], 
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"prunedTree", " ", "=", " ", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"MemberQ", "[", 
                  RowBox[{"highLightPairs", ",", "#"}], "]"}], ",", 
                 RowBox[{"Directive", "[", 
                  RowBox[{"{", 
                   RowBox[{"Thick", ",", 
                    RowBox[{
                    "viSwatch", "[", "\"\<TouchingCircle\>\"", "]"}]}], "}"}],
                   "]"}], ",", 
                 RowBox[{"viSwatch", "[", "\"\<TouchingCircle\>\"", "]"}]}], 
                "]"}], ",", 
               RowBox[{
               "vanItersonTouchingCirclePrimaryOpposed", "[", "#", "]"}]}], 
              "}"}], "&"}], ",", "mnPairs"}], "]"}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
            "viSwatch", "[", "\"\<NonOpposedTouchingCircle\>\"", "]"}], ",", 
            RowBox[{"Map", "[", 
             RowBox[{
             "vanItersonTouchingCirclePrimaryNonOpposed", ",", "mnPairs"}], 
             "]"}]}], "}"}]}], "\[IndentingNewLine]", " ", "}"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Thin", ",", "LightGray", ",", 
             RowBox[{"Map", "[", 
              RowBox[{"vanItersonTouchingCircleNonPrimary", ",", "mnPairs"}], 
              "]"}]}], "}"}], "\[IndentingNewLine]", ",", "  ", "prunedTree", 
           "\[IndentingNewLine]", ",", " ", 
           RowBox[{"Map", "[", 
            RowBox[{"touchingCircleLabel", ",", "labelPairs"}], "]"}]}], 
          "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"FilterRules", "[", 
