Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"jSwatch", " ", "=", " ", 
     RowBox[{"<|", " ", 
      RowBox[{
       RowBox[{"1", "->", "  ", 
        RowBox[{"jParastichyColour", "[", "1", "]"}]}], "\[IndentingNewLine]",
        ",", 
       RowBox[{"2", "->", " ", 
        RowBox[{"jParastichyColour", "[", "2", "]"}]}], "\[IndentingNewLine]",
        ",", 
       RowBox[{"3", "->", " ", 
        RowBox[{"jParastichyColour", "[", "3", "]"}]}], "\[IndentingNewLine]",
        ",", 
       RowBox[{"4", "->", " ", 
        RowBox[{"jStyle", "[", "\"\<CylinderColour\>\"", "]"}]}]}], 
      "\[IndentingNewLine]", " ", "|>"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"makeJugacyPlot", " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"mnPairs", "=", " ", 
         RowBox[{"Join", " ", "[", 
          RowBox[{
           RowBox[{"{", " ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "1"}], "}"}]}], "}"}], ",", 
           RowBox[{"pairsTodo", "[", 
            RowBox[{".005", ",", "50"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pr", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0.5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0.3"}], "}"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"family", "=", 
         RowBox[{"Map", "[", 
          RowBox[{"vanItersonTouchingCirclePrimary", ",", "mnPairs"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"scaledFamily", "[", "n_", "]"}], " ", ":=", " ", 
         RowBox[{"GeometricTransformation", "[", 
          RowBox[{"family", ",", 
           RowBox[{"ScalingTransform", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"1", "/", "n"}], ",", 
              RowBox[{"1", "/", "n"}]}], "}"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"pairedFamily", "[", "n_", "]"}], " ", ":=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"scaledFamily", "[", "n", "]"}], ",", 
           RowBox[{"GeometricTransformation", "[", 
            RowBox[{
             RowBox[{"scaledFamily", "[", "n", "]"}], ",", 
             RowBox[{"ReflectionTransform", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"1", ",", "0"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"1", "/", 
                  RowBox[{"(", 
                   RowBox[{"2", "n"}], ")"}]}], ",", "0"}], "}"}]}], "]"}]}], 
            "]"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"friezeFamily", "[", "n_", "]"}], " ", ":=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"GeometricTransformation", "[", 
            RowBox[{
             RowBox[{"pairedFamily", "[", "n", "]"}], ",", 
             RowBox[{"TranslationTransform", "[", 
              RowBox[{"{", " ", 
               RowBox[{
                RowBox[{"j", "/", "n"}], ",", "0"}], "}"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"jfamily", "[", "n_", "]"}], " ", ":=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"jSwatch", "[", "n", "]"}], ",", 
           RowBox[{"friezeFamily", "[", "n", "]"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Legended", "[", 
         RowBox[{
          RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"jfamily", "[", "n", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"n", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", 
            RowBox[{"Axes", "->", "True"}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", 
                 RowBox[{"1", "/", "2"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "0.3"}], "}"}]}], "}"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Ticks", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", 
                 RowBox[{"1", "/", "2"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "0.3"}], "}"}]}], "}"}]}], ",", 
            RowBox[{"AxesLabel", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<d\>\"", ",", "\"\<h\>\""}], "}"}]}], ",", 
            RowBox[{"LabelStyle", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{"FontFamily", "->", 
               RowBox[{"jStyle", "[", "\"\<FontFamily\>\"", "]"}]}], "]"}]}], 
            "\[IndentingNewLine]", ",", 
            RowBox[{"PlotRangeClipping", "->", "True"}]}], 
           "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",", 
          RowBox[{"LineLegend", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"jSwatch", "[", "nc", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"nc", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"StringTemplate", "[", "\"\<Jugacy ``\>\"", "]"}], "[",
                "nc", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"nc", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", 
            RowBox[{"LabelStyle", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{"FontFamily", "->", 
               RowBox[{"jStyle", "[", "\"\<FontFamily\>\"", "]"}]}], 
              "]"}]}]}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
